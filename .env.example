# ---------------------------------------------------------------------------
# IMI Music — variabili d'ambiente (esempio). Copia in .env e valorizza.
# NON committare mai il file .env con valori reali.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_USER=imi
POSTGRES_PASSWORD=imi_dev_password
POSTGRES_DB=imi_music
POSTGRES_PORT=5432
DATABASE_URL="postgresql://imi:imi_dev_password@localhost:5432/imi_music?schema=public"

# --- Redis (cache, code BullMQ, sessioni) ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- API (NestJS) ---
API_PORT=4000
NODE_ENV=development

# JWT auth (usa segreti lunghi e casuali in staging/prod)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Multi-tenant ---
# Tenant di default per lo sviluppo locale (seed).
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Area file (Sprint 5) ---
# Cartella locale dei file caricati. In produzione sostituire con object storage.
UPLOAD_DIR=./uploads

# --- Object storage S3-compatibile (Fase 1+: master audio/video/grafiche) ---
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=imi-music-assets
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Email transazionale (Sprint 6) ---
# Senza RESEND_API_KEY le notifiche restano solo in-app (l'email viene loggata).
# RESEND_API_KEY=
# EMAIL_FROM="IMI Music <onboarding@resend.dev>"

# --- Osservabilità (Fase 1+) ---
# SENTRY_DSN=
